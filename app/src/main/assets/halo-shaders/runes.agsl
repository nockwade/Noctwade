// name: Rune ring
// Two counter-turning rings of short bars with a faint circle between them.
// Contract: see HALO-SHADERS.md. Draws in the square around the button; the button disc fills radius 0..0.62.
uniform float2 iResolution;
uniform float iTime;
uniform float4 iColor;
uniform float4 iColor2;
uniform float iConnected;
uniform float iConnecting;

float bars(float ang, float count, float duty, float shift) {
    float f = fract((ang + shift) * count / 6.2831853);
    return 1.0 - step(duty, f);
}

half4 main(float2 fragCoord) {
    float2 p = (fragCoord - 0.5 * iResolution) / (0.5 * iResolution.y);
    float d = length(p);
    float ang = atan(p.y, p.x);
    float spin = iTime * (0.25 + 0.2 * iConnected + 1.3 * iConnecting);

    float outer = (1.0 - smoothstep(0.0, 0.022, abs(d - 0.89))) * bars(ang, 18.0, 0.62, spin);
    float inner = (1.0 - smoothstep(0.0, 0.017, abs(d - 0.74))) * bars(ang, 10.0, 0.45, -spin * 1.4);
    float base = (1.0 - smoothstep(0.0, 0.009, abs(d - 0.815))) * 0.55;
    float pulse = 0.85 + 0.15 * sin(iTime * 2.0);
    float glow = exp(-abs(d - 0.815) * 10.0) * 0.28 * pulse;

    float k = outer + inner * 0.9 + base + glow;
    float3 col = mix(iColor.rgb, iColor2.rgb, smoothstep(0.74, 0.89, d));
    col = mix(col, float3(1.0), 0.2 * (outer + inner));
    float alpha = clamp(k, 0.0, 1.0) * (0.8 + 0.2 * iConnected);
    alpha *= smoothstep(0.58, 0.66, d) * (1.0 - smoothstep(0.96, 1.0, d));
    return half4(half3(col * alpha), half(alpha));
}

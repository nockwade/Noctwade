<?xml version="1.0" encoding="utf-8"?>
<!-- Server row: glass; the chosen server gets a translucent accent fill, no outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/nwRipple">
    <item>
        <selector>
            <item android:state_selected="true">
                <layer-list>
                    <item><shape><corners android:radius="18dp" /><gradient android:angle="315" android:startColor="?attr/nwGlassStart" android:endColor="?attr/nwGlassEnd" /><stroke android:width="1dp" android:color="@color/nw_hairline" /></shape></item>
                    <item><shape><corners android:radius="18dp" /><solid android:color="@color/nw_selected_fill" /></shape></item>
                </layer-list>
            </item>
            <item><shape><corners android:radius="18dp" /><gradient android:angle="315" android:startColor="?attr/nwGlassStart" android:endColor="?attr/nwGlassEnd" /><stroke android:width="1dp" android:color="@color/nw_hairline" /></shape></item>
        </selector>
    </item>
    <item android:id="@android:id/mask"><shape><corners android:radius="18dp" /><solid android:color="#FFFFFFFF" /></shape></item>
</ripple>
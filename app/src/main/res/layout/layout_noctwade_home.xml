<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scene"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nwBackground">

    <io.nekohasekai.sagernet.widget.noctwade.SpaceBackdropView
        android:id="@+id/home_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <io.nekohasekai.sagernet.widget.noctwade.AdaptiveHomeScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/home_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <include
                    android:id="@+id/home_header"
                    layout="@layout/layout_noctwade_header" />

                <Space
                    android:id="@+id/home_hero_space"
                    android:layout_width="1dp"
                    android:layout_height="56dp" />

                <io.nekohasekai.sagernet.widget.noctwade.OrbitConnectView
                    android:id="@+id/home_power"
                    android:layout_width="208dp"
                    android:layout_height="208dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:contentDescription="@string/nw_connect_action"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/home_status"
                    style="@style/NwText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/nw_offline"
                    android:textSize="26sp" />

                <!-- Session length while connected, e.g. "12:04". -->
                <TextView
                    android:id="@+id/home_timer"
                    style="@style/NwCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:textColor="?attr/nwAccent"
                    android:textSize="16sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/home_subtitle"
                    style="@style/NwCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/nw_tap_connect"
                    android:textSize="14sp" />

                <!-- Pushes the subscription and server cards to the bottom of the screen. -->
                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="28dp" />

                <include
                    android:id="@+id/home_quota"
                    layout="@layout/layout_noctwade_quota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" />

                <LinearLayout
                    android:id="@+id/home_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/nw_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <io.nekohasekai.sagernet.widget.noctwade.CountryFlagView
                        android:id="@+id/home_server_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <io.nekohasekai.sagernet.widget.noctwade.SlowMarqueeTextView
                            android:id="@+id/home_server_name"
                            style="@style/NwText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/nw_no_server"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/home_server_detail"
                            style="@style/NwCaption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/nw_locations"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/home_ping"
                        style="@style/NwCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/nw_pill"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/nw_ping_unknown"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/nw_chevron"
                        android:tint="?attr/nwMuted" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </io.nekohasekai.sagernet.widget.noctwade.AdaptiveHomeScrollView>
</FrameLayout>

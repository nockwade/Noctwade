<?xml version="1.0" encoding="utf-8"?>
<!-- Server row: flag, name, "protocol · security"; ping square and quality bars on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/nw_server_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <io.nekohasekai.sagernet.widget.noctwade.CountryFlagView
        android:id="@+id/server_flag"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <io.nekohasekai.sagernet.widget.noctwade.SlowMarqueeTextView
            android:id="@+id/server_name"
            style="@style/NwText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/server_detail"
            style="@style/NwCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp" />
    </LinearLayout>

    <io.nekohasekai.sagernet.widget.noctwade.PingButtonView
        android:id="@+id/server_ping"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/nw_test_server" />

    <io.nekohasekai.sagernet.widget.noctwade.SignalStrengthView
        android:id="@+id/server_signal"
        android:layout_width="18dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp" />
</LinearLayout>
